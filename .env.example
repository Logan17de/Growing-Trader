# Groww authentication: choose one supported flow for local/manual use.
GROWW_ACCESS_TOKEN=
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_TOTP_TOKEN=
GROWW_TOTP_SECRET=

# Execution remains paper-only.
EXECUTION_MODE=paper

# Supabase service access. Used by the Oracle worker and Vercel server routes.
# Never expose SERVICE_ROLE_KEY in browser/client code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared 32-byte base64 key used to encrypt Groww credentials at rest.
# Set the same value in Vercel and on the Oracle worker.
BROKER_CREDENTIAL_ENCRYPTION_KEY=

# Vercel dashboard authentication (server-side only).
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=

# Browser-only Supabase variables for the live signal stream.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
