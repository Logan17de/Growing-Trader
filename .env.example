# Groww authentication: choose one supported flow for local/manual use.
GROWW_ACCESS_TOKEN=
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_TOTP_TOKEN=
GROWW_TOTP_SECRET=

# Execution remains paper-only.
EXECUTION_MODE=paper

# Live paper-engine tuning. These are research/runtime settings, not profitability claims.
PAPER_ACCOUNT_EQUITY=2000000
PAPER_QUOTE_SCAN_SECONDS=20
PAPER_OPTION_REFRESH_SECONDS=20
PAPER_FEED_POLL_SECONDS=1
PAPER_SIGNAL_PERSIST_SECONDS=30
PAPER_MAX_DATA_AGE_SECONDS=30
NIFTY50_SYMBOLS_PATH=

# Supabase service access. Used only by the Oracle worker and Vercel server routes.
# The value may be the modern Supabase sb_secret_... key. Never expose it in browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared 32-byte base64 key used to encrypt Groww credentials at rest.
# Vercel and Oracle must use the exact same value.
BROKER_CREDENTIAL_ENCRYPTION_KEY=

# Vercel dashboard authentication (server-side only).
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
